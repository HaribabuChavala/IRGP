# Base infrastructure
COMPOSE_PROJECT_NAME=instant-report-generation-platform
POSTGRES_USER=admin
POSTGRES_PASSWORD=postgres-dev-password
POSTGRES_DB=report_platform
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-dev-password
VAULT_ROOT_TOKEN=dev-root-token
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256

# App/runtime endpoints
KEYCLOAK_ISSUER=http://localhost:8081/realms/report-platform
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/report-platform/protocol/openid-connect/certs
OPA_URL=http://opa:8181
REDIS_URL=redis://redis:6379/0
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token
VAULT_SECRET_PATH=secret/data/report-platform
VAULT_GOOGLE_ADK_API_KEY_FIELD=GOOGLE_ADK_AGENT_API_KEY
DATABASE_URL=postgresql+psycopg://admin:postgres-dev-password@postgres:5432/report_platform

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://report.localhost
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8081
NEXT_PUBLIC_KEYCLOAK_REALM=report-platform
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=report-platform-ui

# AI SQL microservice integration
AI_SQL_SERVICE_URL=http://ai-sql-service:8000/generate-sql
GOOGLE_ADK_AGENT_URL=http://google-adk-agent:8001/agent
GOOGLE_ADK_AGENT_API_KEY=local-adk-test-key
GOOGLE_GEMINI_MODEL=gemini-3.6-flash
MAX_SQL_LIMIT=1000
DENY_STAR_SELECT=true
ENFORCE_ROW_LIMIT=true
REQUIRE_TENANT_ALLOWLIST=true
TENANT_TABLE_ALLOWLIST_JSON={"tenant-demo":["testing.sales_orders","testing.sales_order_items","testing.customers","testing.products"],"bbe41162-bb3c-4d02-b0fc-ce48d7905d33":["testing.sales_orders","testing.sales_order_items","testing.customers","testing.products"]}

# Microservice defaults
MICROSERVICE_JWT_SECRET_KEY=dev-secret-change-me
MICROSERVICE_JWT_ALGORITHM=HS256

# Mail delivery for onboarding invitations
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@report.localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SENDGRID_API_KEY=
