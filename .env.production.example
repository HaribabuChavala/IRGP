# Production-like deployment template
# Copy this to .env.production or inject these variables into CI/CD / Kubernetes / Docker secrets.
# Do not commit real secrets to source control.

COMPOSE_PROJECT_NAME=instant-report-generation-platform

# Core infrastructure
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace-with-secure-postgres-password
POSTGRES_DB=report_platform
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-secure-keycloak-password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-secure-keycloak-db-password
VAULT_ROOT_TOKEN=replace-with-secure-vault-root-token
JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256

# Runtime endpoints
KEYCLOAK_ISSUER=https://auth.example.com/realms/report-platform
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/report-platform/protocol/openid-connect/certs
OPA_URL=http://opa:8181
REDIS_URL=redis://redis:6379/0
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=replace-with-vault-token
VAULT_SECRET_PATH=secret/data/report-platform
VAULT_GOOGLE_ADK_API_KEY_FIELD=GOOGLE_ADK_AGENT_API_KEY
DATABASE_URL=postgresql+psycopg://app_user:replace-with-secure-postgres-password@postgres:5432/report_platform

# Frontend
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.example.com
NEXT_PUBLIC_KEYCLOAK_REALM=report-platform
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=report-platform-ui

# AI SQL microservice integration
AI_SQL_SERVICE_URL=http://ai-sql-service:8000/generate-sql
GOOGLE_ADK_AGENT_URL=https://adk.example.com/generate
GOOGLE_ADK_AGENT_API_KEY=replace-with-adk-api-key
GOOGLE_GEMINI_MODEL=gemini-3.6-flash
MAX_SQL_LIMIT=1000
DENY_STAR_SELECT=true
ENFORCE_ROW_LIMIT=true
REQUIRE_TENANT_ALLOWLIST=true
TENANT_TABLE_ALLOWLIST_JSON={"tenant-prod-1":["finance.sales_orders","finance.customers","finance.products"],"tenant-prod-2":["analytics.fact_sales","analytics.dim_customer","analytics.dim_product"]}

# Microservices
MICROSERVICE_JWT_SECRET_KEY=replace-with-long-random-secret
MICROSERVICE_JWT_ALGORITHM=HS256

# Mail delivery for onboarding invitations
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=replace-with-real-smtp-or-sendgrid-password
SMTP_USE_TLS=true
SENDGRID_API_KEY=replace-with-sendgrid-api-key
