{{- $root := . -}}
{{- range $name, $svc := .Values.services }}
apiVersion: v1
kind: Service
metadata:
  name: {{ include "report-platform.fullname" $root }}-{{ $name }}
  labels:
    {{ include "report-platform.labels" $root | indent 4 }}
    component: {{ $name }}
spec:
  selector:
    app: {{ include "report-platform.fullname" $root }}-{{ $name }}
  ports:
    - protocol: TCP
      port: {{ $svc.port }}
      targetPort: {{ $svc.port }}
  type: ClusterIP
---
{{- end }}
