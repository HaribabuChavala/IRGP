generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  free
  trial
  year
  half_year
  starter
  growth
  enterprise
}

enum OrganizationStatus {
  active
  trial
  suspended
  archived
}

enum UserStatus {
  active
  invited
  disabled
}

enum DataSourceType {
  oracle
  hive
  postgres
  mysql
  excel
  csv
  api
  warehouse
}

enum DataSourceStatus {
  connected
  disconnected
  error
  pending
}

enum ReportJobStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum QueryStatus {
  queued
  running
  completed
  failed
}

enum NotificationType {
  report
  subscription
  system
  alert
  info
}

enum ReminderType {
  subscription
  renewal
  payment
  system
}

enum AuditDecision {
  allow
  deny
}

enum RoleName {
  PLATFORM_ADMIN
  REPORT_ADMIN
  REPORT_USER
  VIEWER
}

model Organization {
  id            String   @id @default(uuid())
  externalId    String?  @map("external_id")
  name          String
  plan          PlanType @default(free)
  status        OrganizationStatus @default(active)
  region        String
  contactEmail  String?  @map("contact_email")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users         User[]
  dataSources   DataSource[]
  reportJobs    ReportJob[]
  reports       Report[]
  queryHistory  QueryHistory[]
  notifications Notification[]
  reminders     Reminder[]
  auditEvents   AuditEvent[]

  @@map("organizations")
}

model User {
  id               String      @id @default(uuid())
  keycloakUserId   String?     @unique @map("keycloak_user_id")
  email            String      @unique
  username         String
  fullName         String?     @map("full_name")
  organization     Organization? @relation(fields: [organizationId], references: [id])
  organizationId   String?     @map("organization_id")
  tenantId         String?     @map("tenant_id")
  region           String?
  organizationName String?     @map("organization_name")
  status           UserStatus  @default(active)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  userRoles        UserRole[]
  reportJobs       ReportJob[]
  queryHistory     QueryHistory[]
  notifications    Notification[]
  auditEvents      AuditEvent[]

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  description String?

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id")
  roleId Int    @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model DataSource {
  id           String          @id @default(uuid())
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String        @map("organization_id")
  name         String
  type         DataSourceType
  host         String?
  port         Int?
  databaseName String?         @map("database_name")
  filePath     String?         @map("file_path")
  status       DataSourceStatus @default(connected)
  lastUsedAt   DateTime?       @map("last_used_at")
  queryCount   Int             @default(0) @map("query_count")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  reportJobs   ReportJob[]
  queryHistory QueryHistory[]

  @@map("data_sources")
}

model ReportJob {
  id            String         @id @default(uuid())
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String         @map("user_id")
  dataSource    DataSource?    @relation(fields: [dataSourceId], references: [id])
  dataSourceId  String?        @map("data_source_id")
  prompt        String
  status        ReportJobStatus @default(queued)
  progress      Int            @default(0)
  resultSummary Json?          @map("result_summary")
  exportUrl     String?        @map("export_url")
  createdAt     DateTime       @default(now()) @map("created_at")
  startedAt     DateTime?      @map("started_at")
  completedAt   DateTime?      @map("completed_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  reports       Report[]

  @@map("report_jobs")
}

model Report {
  id            String      @id @default(uuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String      @map("organization_id")
  job           ReportJob?   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobId         String?     @map("job_id")
  title         String
  tenantId      String?     @map("tenant_id")
  region        String?
  content       String
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("reports")
}

model QueryHistory {
  id            String       @id @default(uuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String      @map("organization_id")
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?      @map("user_id")
  dataSource    DataSource?  @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  dataSourceId  String?      @map("data_source_id")
  prompt        String
  dataSourceName String?     @map("data_source_name")
  status        QueryStatus  @default(completed)
  rowCount      Int          @default(0) @map("row_count")
  executedAt    DateTime     @default(now()) @map("executed_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("query_history")
}

model Notification {
  id            String      @id @default(uuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String      @map("organization_id")
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?      @map("user_id")
  title         String
  message       String
  type          NotificationType @default(info)
  isRead        Boolean      @default(false) @map("is_read")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("notifications")
}

model Reminder {
  id            String      @id @default(uuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String      @map("organization_id")
  title         String
  message       String
  reminderType  ReminderType @default(subscription) @map("reminder_type")
  dueAt         DateTime?    @map("due_at")
  isSent        Boolean      @default(false) @map("is_sent")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("reminders")
}

model AuditEvent {
  id            Int         @id @default(autoincrement())
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId String?     @map("organization_id")
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?     @map("user_id")
  username      String?
  userRoles     Json?       @map("user_roles")
  tenantId      String?     @map("tenant_id")
  region        String?
  resourceType  String?     @map("resource_type")
  resourceId    String?     @map("resource_id")
  resource      Json?
  action        String
  decision      AuditDecision
  reason        String?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("audit_events")
}

model SubscriptionPlan {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  name          String
  price         Decimal  @default(0)
  quotaMonthly  BigInt   @default(0) @map("quota_monthly")
  features      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("subscription_plans")
}
